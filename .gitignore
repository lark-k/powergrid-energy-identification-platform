# Dependencies
**/node_modules/
**/.vendor/

# Build outputs and caches
**/dist/
**/.vite/
**/.cache/
**/*.tsbuildinfo
**/target/

# Python bytecode, environments, and packaging artifacts
**/__pycache__/
**/*.py[cod]
**/*$py.class
**/.venv/
**/venv/
**/env/
**/.pytest_cache/
**/.mypy_cache/
**/.ruff_cache/
**/.tox/
**/.nox/
**/.coverage
**/.coverage.*
**/htmlcov/
**/build/
**/*.egg-info/
**/pip-wheel-metadata/

# Test and coverage artifacts
**/coverage/
**/test-results/
**/playwright-report/
**/blob-report/

# Local environment files
**/.env
**/.env.*
!**/.env.example
!deploy/.env.server.example
**/*.local

# Runtime logs
**/*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Local database backups
deploy/backups/*.dump
deploy/releases/
deploy/runtime-data/

# Local-only generated or recovered files
.local/
.codegraph/
**/.codex_tmp*/

# Local design references, QA reports, and browser captures
# Runtime images and user-facing guide assets remain versioned separately.
/design-qa.md
/docs/design-qa/

# Generated model datasets and inference/training outputs
SGCC-project/energy_device_detection/artifacts/*.npz
SGCC-project/energy_device_detection/artifacts/aligned_*.csv
SGCC-project/energy_device_detection/artifacts/data_inventory.csv
SGCC-project/energy_device_detection/outputs/*
!SGCC-project/energy_device_detection/outputs/selected_model.pt
!SGCC-project/energy_device_detection/outputs/model_comparison.json
!SGCC-project/energy_device_detection/outputs/tcn_checkpoint.pt
SGCC-project/energy_device_detection/pv_outputs/*
!SGCC-project/energy_device_detection/pv_outputs/selected_pv_model.pt
!SGCC-project/energy_device_detection/pv_outputs/pv_model_comparison.json
!SGCC-project/energy_device_detection/pv_outputs/causal_tcn_checkpoint.pt

# IDE and OS metadata
**/.idea/
**/.vscode/*
!**/.vscode/extensions.json
.DS_Store
Thumbs.db
Desktop.ini

# Temporary files
**/*.tmp
**/*.temp
**/*.bak
**/*~
