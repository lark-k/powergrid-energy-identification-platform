# Dependencies
**/node_modules/

# Build outputs and caches
**/dist/
**/.vite/
**/.cache/
**/*.tsbuildinfo

# Test and coverage artifacts
**/coverage/
**/test-results/
**/playwright-report/
**/blob-report/

# Local environment files
**/.env
**/.env.*
!**/.env.example
**/*.local

# Runtime logs
**/*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Local-only generated or recovered files
.local/

# IDE and OS metadata
**/.idea/
**/.vscode/*
!**/.vscode/extensions.json
.DS_Store
Thumbs.db
Desktop.ini

# Temporary files
**/*.tmp
**/*.temp
**/*.bak
**/*~

