MODEL_SERVICE_ENV=development
SGCC_PROJECT_DIR=../SGCC-project
RECOGNITION_CHECKPOINT=../SGCC-project/energy_device_detection/outputs/selected_model.pt
SEPARATION_CHECKPOINT=../SGCC-project/energy_device_detection/pv_outputs/selected_pv_model.pt
MODEL_DEVICE=auto
MODEL_BATCH_SIZE=256
MODEL_INFERENCE_TIMEOUT_SECONDS=30
MODEL_SERVICE_AUTH_REQUIRED=false
# Optional task subdirectories: resource_identification/*.pt and pv_separation/*.pt.
# MODEL_CATALOG_DIR=../.local/model-runtime/catalog
MODEL_ACTIVE_STATE_PATH=../.local/model-runtime/active.json
# MODEL_SERVICE_TOKEN must be injected from a secret in production.
