# Copy this file to deploy/.env.server and replace every CHANGE_ME value.
# POWERGRID_DATA_DIR must be an absolute path on the server.
POWERGRID_DATA_DIR=/srv/powergrid

POSTGRES_DB=powergrid
POSTGRES_USER=powergrid_dev
POSTGRES_PASSWORD=CHANGE_ME_DEMO_MODE_ONLY
MODEL_SERVICE_TOKEN=CHANGE_ME_DEMO_MODE_ONLY

MODEL_DEVICE=cpu
MODEL_BATCH_SIZE=256
MODEL_INFERENCE_TIMEOUT_SECONDS=30
FRONTEND_PORT=5173
SPRING_PROFILES_ACTIVE=dev
SECURITY_MODE=dev
CORS_ALLOWED_ORIGINS=http://SERVER_IP_OR_DOMAIN:5173

# Production mode reads these files through Docker secrets. Use absolute paths.
DB_PASSWORD_SECRET_FILE=/srv/powergrid/secrets/db-password.txt
MODEL_SERVICE_TOKEN_SECRET_FILE=/srv/powergrid/secrets/model-service-token.txt
OIDC_ISSUER_URI=https://oidc.example.invalid/realms/powergrid
